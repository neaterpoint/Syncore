@page "/"

<PageTitle>Syncore | Keep your project links in sync</PageTitle>

<AuthorizeView>
    <Authorized>
        <RedirectToProjects />
    </Authorized>
    <NotAuthorized>
        <section class="hero-page">
            <div class="hero-grid absolute inset-0" aria-hidden="true"></div>

            <svg class="hero-decoration hero-decoration-folder" aria-hidden="true"><use href="/images/icons.svg#folder"></use></svg>
            <svg class="hero-decoration hero-decoration-refresh" aria-hidden="true"><use href="/images/icons.svg#refresh"></use></svg>
            <svg class="hero-decoration hero-decoration-lock" aria-hidden="true"><use href="/images/icons.svg#lock"></use></svg>
            <svg class="hero-decoration hero-decoration-link" aria-hidden="true"><use href="/images/icons.svg#link"></use></svg>
            <svg class="hero-decoration hero-decoration-chat" aria-hidden="true"><use href="/images/icons.svg#chat"></use></svg>

            <div class="hero-content relative z-10">
                <h1>Keep your <span>project</span> links in <span>sync.</span></h1>
                <p>A frictionless hub for teams to organize external links, docs, and tasks—no registration required.</p>

                <div class="hero-actions">
                    <a class="button button-primary" href="/account">
                        <svg aria-hidden="true"><use href="/images/icons.svg#folder-plus"></use></svg>
                        Start a Project
                    </a>
                    <a class="button button-secondary" href="/account">
                        <svg aria-hidden="true"><use href="/images/icons.svg#users"></use></svg>
                        Join a Project
                    </a>
                </div>
            </div>

        </section>
    </NotAuthorized>
</AuthorizeView>
